class Solution:
    def smallestUniqueSubarray(self, nums):
        n = len(nums)

        sa = list(range(n))
        rank = nums[:]
        k = 1

        while k < n:
            sa.sort(key=lambda i: (
                rank[i],
                rank[i + k] if i + k < n else -1
            ))

            new_rank = [0] * n

            for i in range(1, n):
                a = sa[i - 1]
                b = sa[i]

                key_a = (
                    rank[a],
                    rank[a + k] if a + k < n else -1
                )
                key_b = (
                    rank[b],
                    rank[b + k] if b + k < n else -1
                )

                new_rank[b] = new_rank[a] + (key_a != key_b)

            rank = new_rank

            if rank[sa[-1]] == n - 1:
                break

            k *= 2

        pos = [0] * n
        for i in range(n):
            pos[sa[i]] = i

        lcp = [0] * n
        h = 0

        for i in range(n):
            r = pos[i]

            if r == 0:
                continue

            j = sa[r - 1]

            while i + h < n and j + h < n and nums[i + h] == nums[j + h]:
                h += 1

            lcp[r] = h

            if h:
                h -= 1

        ans = n

        for r in range(n):
            max_lcp = lcp[r]

            if r + 1 < n:
                max_lcp = max(max_lcp, lcp[r + 1])

            length = max_lcp + 1

            if sa[r] + length <= n:
                ans = min(ans, length)

        return ans
